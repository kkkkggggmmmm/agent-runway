{
  "name": "agent-runway",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "bridge": "node server/server.mjs",
    "dev:all": "concurrently -k -n bridge,ui -c yellow,cyan \"npm:bridge\" \"npm:dev\"",
    "build": "tsc -b && vite build && node scripts/copy-mobile-assets.mjs",
    "preview": "vite preview",
    "start": "node server/server.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
