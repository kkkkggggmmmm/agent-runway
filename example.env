# Generate unique values with: openssl rand -hex 32
AGENT_RUNWAY_BOOTSTRAP_TOKEN=replace-with-a-one-time-64-character-token
AGENT_RUNWAY_SESSION_SECRET=replace-with-a-different-64-character-session-secret
# Local-only Docker Compose defaults. A production host should terminate HTTPS.
AGENT_RUNWAY_BIND_ADDRESS=127.0.0.1
AGENT_RUNWAY_PORT=8080
